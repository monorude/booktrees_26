{
  "name": "bt-bookshelf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply bt-bookshelf-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply bt-bookshelf-db --remote"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "wrangler": "^4.0.0"
  }
}
